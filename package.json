{
  "name": "could-i-live-here",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-maplibre-worker.mjs",
    "prebuild": "node scripts/prepare-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "data:refresh": "python3 scripts/export_overture.py",
    "repo:export": "python3 scripts/export_repo.py",
    "test:e2e": "python3 -m unittest discover -s tests/e2e -p \"test_*.py\" -v",
    "test:e2e:live": "LIVE_MAP_STYLE=1 python3 -m unittest discover -s tests/e2e -p \"test_*.py\" -v"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
